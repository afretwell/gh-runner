# ---- Target (required) ------------------------------------------------------
# Org or user that owns the runner. Leave GITHUB_REPO empty for an org-wide runner.
GITHUB_OWNER=my-org
GITHUB_REPO=my-repo

# ---- Auth (set one) ---------------------------------------------------------
# PAT (recommended): fetches fresh registration tokens and deregisters on stop.
#   classic PAT:  repo scope (repo runner) or admin:org (org runner)
#   fine-grained: Administration read/write (repo) or Self-hosted runners read/write (org)
ACCESS_TOKEN=
# Or a one-time registration token from Settings > Actions > Runners > New runner.
# It expires after 1 hour, so it will not survive restarts. Ignored if ACCESS_TOKEN is set.
RUNNER_TOKEN=

# ---- Runner -----------------------------------------------------------------
# Default name is <RUNNER_NAME_PREFIX>-<container hostname>.
# Set RUNNER_NAME only when running a single replica.
RUNNER_NAME_PREFIX=runner
RUNNER_NAME=
# Comma-separated extra labels (self-hosted, Linux, X64 are added automatically).
RUNNER_LABELS=docker
# Org runners only; the group must already exist.
RUNNER_GROUP=
RUNNER_WORKDIR=/home/runner/_work
# true = take one job, deregister, then the container restarts as a fresh runner.
EPHEMERAL=false
DISABLE_AUTO_UPDATE=false
NO_DEFAULT_LABELS=false

# ---- Host / image -----------------------------------------------------------
RUNNER_REPLICAS=1
RUNNER_VERSION=2.338.2
# Space-separated apt packages to bake into the image.
EXTRA_PACKAGES=
# Host docker socket to mount (rootless podman: /run/user/1000/podman/podman.sock).
DOCKER_SOCK=/var/run/docker.sock

# ---- GitHub Enterprise Server (optional) -----------------------------------
GITHUB_URL=https://github.com
# Derived from GITHUB_URL when empty (api.github.com or <GITHUB_URL>/api/v3).
GITHUB_API_URL=
